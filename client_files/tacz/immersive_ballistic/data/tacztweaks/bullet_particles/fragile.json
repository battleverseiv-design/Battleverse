                }
            ],
    "pierce":  [
                   {
                       "particle":  "minecraft:block %s",
                       "count":  20,
                       "speed":  2,
                       "force":  true
                   }
               ],
    "break":  {
                  "particle":  "minecraft:block %s",
                  "count":  5,
                  "speed":  0.3,
                  "force":  true
              }
}
