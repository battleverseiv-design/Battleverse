{
    "type":  "block",
    "blocks":  [
                   "#tacztweaks:fragile",
                   "#immersive_ballistic:fragile",
                   {
                       "type": "regex",
                       "regex": ".*(bamboo|((weathered|rusted).*bars)).*"
                   }
               ],
    "hit":  [
                {
                    "particle":  "minecraft:block %s",
                    "count":  10,
